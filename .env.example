DATABASE_URL="postgresql://user:password@localhost:5432/jyotish?schema=public"
JWT_SECRET="your_jwt_secret"

# --- ZEGOCLOUD (Chat & Video) ---
ZEGOCLOUD_APP_ID=your_zego_app_id
ZEGOCLOUD_SERVER_SECRET="your_zego_server_secret"
NEXT_PUBLIC_ZEGO_APP_ID=your_zego_app_id
NEXT_PUBLIC_ZEGO_SERVER_SECRET="your_zego_server_secret"

# --- RAZORPAY ---
RAZORPAY_KEY_ID="your_razorpay_key"
RAZORPAY_SECRET_KEY="your_razorpay_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="your_razorpay_key"

# --- PAYPAL ---
PAYPAL_CLIENT_ID="your_paypal_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_secret"

# --- CLOUDINARY ---
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# --- AI APIs ---
GEMINI_API_KEY="your_gemini_key"
OPENAI_API_KEY="your_openai_key"
